{
  "debian": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "mounts": [{ "type": "volume", "source": "drydock-feature-test-debian", "target": "/home/vscode/.claude" }],
    "features": {
      "drydock": {
        "requireBroker": false,
        "botName": "krelinga-drydock-dev[bot]",
        "botEmail": "337849865+krelinga-drydock-dev[bot]@users.noreply.github.com"
      }
    }
  },
  "ubuntu-bare": {
    "image": "ubuntu:noble",
    "remoteUser": "ubuntu",
    "mounts": [{ "type": "volume", "source": "drydock-feature-test-ubuntu", "target": "/home/vscode/.claude" }],
    "features": {
      "drydock": { "requireBroker": false }
    }
  },
  "no-guard": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "mounts": [{ "type": "volume", "source": "drydock-feature-test-no-guard", "target": "/home/vscode/.claude" }],
    "features": {
      "drydock": { "requireBroker": false, "branchPrefix": "" }
    }
  }
}
