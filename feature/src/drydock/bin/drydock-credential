#!/bin/sh
# drydock-credential — git's credential helper for github.com (design §9.2).
#
#   [credential "https://github.com"]
#       helper = /usr/local/drydock/bin/drydock-credential
#
# `get` asks the broker for a token scoped to this workspace's repository and
# prints exactly two lines, username and password; git never stores either.
# `store` and `erase` are no-ops that succeed: a helper that fails them makes
# git warn on every push (testing §6.6).
#
# printf is a shell builtin, so the token never appears in any process's argv.
set -u

case ${1:-} in
get)
	host=
	while IFS= read -r line && [ -n "$line" ]; do
		case $line in host=*) host=${line#host=} ;; esac
	done
	# Only GitHub: a helper that hands this token to any host git asks about
	# would send it to whatever remote a repository names.
	# DRYDOCK_GITHUB_HOST exists for the tests' fake remote. It opens nothing:
	# whoever can set it in here can already ask the socket for this token.
	[ "$host" = "${DRYDOCK_GITHUB_HOST:-github.com}" ] || exit 0
	answer=$(drydock-broker GET-TOKEN scope=git) || exit 1
	token=${answer#*token=}
	token=${token%% *}
	printf 'username=x-access-token\npassword=%s\n' "$token"
	;;
store | erase)
	cat >/dev/null
	;;
esac
exit 0
