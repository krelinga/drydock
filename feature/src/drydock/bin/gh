#!/bin/sh
# gh — a shim ahead of the real gh on PATH (design §9.2). gh reads GH_TOKEN
# from its environment, and an environment cannot refresh itself, so every
# invocation fetches a token from the broker — cached there for 55 minutes,
# so twenty calls are one GitHub request — and execs the real gh with it.
#
# The token reaches the child's environment, never its argv.
set -u

# The first gh on PATH that is not this script, under any name: the Feature
# links the shim from /usr/local/bin as well as keeping it in its own
# directory, so skipping only this directory would find the other copy and
# exec it forever.
self=$(readlink -f "$0")
real=
IFS=:
for d in $PATH; do
	[ -n "$d" ] || continue
	[ "$(readlink -f "$d/gh" 2>/dev/null)" = "$self" ] && continue
	if [ -x "$d/gh" ]; then
		real=$d/gh
		break
	fi
done
unset IFS
# A gh the Feature moved out of /usr/local/bin to make room for this shim.
[ -n "$real" ] || { [ -x /usr/local/drydock/real/gh ] && real=/usr/local/drydock/real/gh; }
if [ -z "$real" ]; then
	echo "drydock: gh is not installed" >&2
	exit 127
fi

answer=$(drydock-broker GET-TOKEN scope=gh) || exit 1
token=${answer#*token=}
GH_TOKEN=${token%% *}
export GH_TOKEN
exec "$real" "$@"
