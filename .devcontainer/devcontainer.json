{
  "name": "drydock",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    // Primary language (§3.2). This feature also installs golangci-lint, so no
    // separate lint feature is needed.
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest",
      "golangciLintVersion": "latest"
    },

    // Needed for the devcontainer CLI, which ships as an npm package.
    "ghcr.io/devcontainers/features/node:2": { "version": "lts" },

    // Docker-IN-docker, deliberately, not docker-outside-of-docker: Drydock hands
    // the daemon host paths to bind-mount (/srv/drydock/ws/<id>/repo, the broker
    // sockets). With DooD the daemon is the host's, so those paths resolve
    // differently inside and outside this container and every mount breaks -- the
    // exact problem §1 cites for not containerizing Drydock. With DinD the daemon
    // lives in here, so a path is the same path to both sides.
    // Tag 4, not 2: the `2` tag is a stale 2.x line, current major is 4.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},

    // Every container operation shells out to this CLI (§3.2).
    "ghcr.io/devcontainers-extra/features/devcontainers-cli:1": {},

    // The front door (§13.1). golangVersion:none because this feature otherwise
    // nests its own Go install and would fight the pinned one above.
    "ghcr.io/devcontainers-extra/features/caddy:1": { "golangVersion": "none" },

    // Exercising the App installation and the `gh` shim's behaviour (§9.2).
    "ghcr.io/devcontainers/features/github-cli:1": {},

    // sqlite3   -- inspect the WAL-mode store (§4)
    // socat, nc -- probe the broker's Unix sockets; `nc` is also the fallback the
    //              in-container broker client is specified to use (§5)
    // jq        -- parse `devcontainer ... --json` output (§2.5)
    // libnss3-tools -- certutil, to trust the browser tier's throwaway CA in
    //              Chromium's NSS store. Spike 04: it is the only trust route
    //              that keeps certificate validation on, so the tier can still
    //              notice a misissued cert. Playwright's browsers are NOT here;
    //              `--with-deps` pulls ~40 transitive libs, so it stays a
    //              lifecycle install (see below).
    // build-essential -- cgo, for the SQLite driver
    "ghcr.io/devcontainers-extra/features/apt-get-packages:1": {
      "packages": "sqlite3,socat,netcat-openbsd,jq,build-essential,ca-certificates,tmux,libnss3-tools"
    },

    // PINNED. CLAUDE.md requires an exact version because five spikes measure
    // undocumented internals of one. This feature had no pin, so the 4 Oct
    // rebuild silently moved 2.1.246 -> 2.1.289 and falsified three recorded
    // findings (see spike reports). Bump deliberately, via the §11.1 ritual.
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {
      "version": "2.1.289"
    }
  },

  // Keep images and build cache across rebuilds of this container. Without it the
  // inner daemon starts empty every time and each spike re-pulls its base images.
  // One container at a time only -- two dockerds on one volume corrupts it.
  //
  // ms-playwright is the same idea for the browser tier: `playwright install`
  // fetches ~114 MB of Chromium, plus Firefox and WebKit (~100 MB each, for
  // engines.spec.ts: v0.2.1's UI sent `Origin: null` from Safari, which
  // Chromium alone could not show), and without this they are re-fetched on
  // every rebuild. The browsers are deliberately not installed by a feature --
  // they are the postCreate lifecycle command below, `npm ci` in web/ and then
  //   npx playwright install --with-deps chromium firefox webkit
  // which picks the builds web/package.json's pinned Playwright wants (a
  // no-op download when the volume already holds them) plus the system
  // libraries they need. Enumerating those ~40 transitive apt packages in the
  // feature above instead would be a list that goes stale silently.
  // The ms-playwright volume below makes Docker create /home/vscode/.cache as
  // root to host the mount point, which breaks every other user-level cache
  // under it -- the Go build cache first. Chown both back on create.
  //
  // drydock-gh-config is gh's login, so a fine-grained token survives a
  // rebuild instead of being pasted in again. Same root-owned-parent problem,
  // for /home/vscode/.config. 0700 because hosts.yml holds the token in plain
  // text: there is no keyring in this container.
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.cache /home/vscode/.cache/ms-playwright /home/vscode/.config /home/vscode/.config/gh && chmod 0700 /home/vscode/.config/gh && cd web && npm ci && npx playwright install --with-deps chromium firefox webkit",

  "mounts": [
    "source=drydock-dind-lib,target=/var/lib/docker,type=volume",
    "source=drydock-playwright-cache,target=/home/vscode/.cache/ms-playwright,type=volume",
    "source=drydock-gh-config,target=/home/vscode/.config/gh,type=volume"
  ]
}
