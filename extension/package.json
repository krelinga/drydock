{
  "name": "drydock",
  "displayName": "Drydock",
  "description": "Clone a repository into a Drydock workspace and connect to it, from the command palette.",
  "publisher": "krelinga",
  "version": "0.14.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/krelinga/drydock"
  },
  "engines": {
    "vscode": "^1.105.0",
    "node": ">=22.12.0"
  },
  "extensionKind": [
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "drydock": {
    "apiRange": [
      1,
      1
    ]
  },
  "contributes": {
    "commands": [
      {
        "command": "drydock.go",
        "title": "Go to Workspace…",
        "category": "Drydock",
        "icon": "$(search)"
      },
      {
        "command": "drydock.clone",
        "title": "Clone Repository…",
        "category": "Drydock"
      },
      {
        "command": "drydock.connect",
        "title": "Connect to Workspace…",
        "category": "Drydock",
        "icon": "$(remote)"
      },
      {
        "command": "drydock.refreshRepositories",
        "title": "Refresh Repositories",
        "category": "Drydock",
        "icon": "$(refresh)"
      },
      {
        "command": "drydock.reviewApproval",
        "title": "Review Host Access…",
        "category": "Drydock",
        "icon": "$(shield)"
      },
      {
        "command": "drydock.approve",
        "title": "Approve Host Access…",
        "category": "Drydock",
        "icon": "$(check)"
      },
      {
        "command": "drydock.decline",
        "title": "Cancel Host-Access Request",
        "category": "Drydock",
        "icon": "$(close)"
      },
      {
        "command": "drydock.signIn",
        "title": "Sign In",
        "category": "Drydock"
      },
      {
        "command": "drydock.signOut",
        "title": "Sign Out",
        "category": "Drydock"
      },
      {
        "command": "drydock.openInBrowser",
        "title": "Open in Drydock",
        "category": "Drydock"
      },
      {
        "command": "drydock.showLog",
        "title": "Show Log",
        "category": "Drydock"
      }
    ],
    "keybindings": [
      {
        "command": "drydock.go",
        "key": "ctrl+alt+shift+d",
        "mac": "cmd+alt+shift+d"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "drydock",
          "title": "Drydock",
          "icon": "media/drydock.svg"
        }
      ]
    },
    "views": {
      "drydock": [
        {
          "id": "drydock.workspaces",
          "name": "Workspaces"
        },
        {
          "id": "drydock.repositories",
          "name": "Repositories"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "drydock.workspaces",
        "contents": "Drydock is not signed in here.\n[Sign In](command:drydock.signIn)\nA token comes from Drydock's Settings. Set drydock.url to Drydock's address first.",
        "when": "!drydock.signedIn"
      },
      {
        "view": "drydock.workspaces",
        "contents": "No workspaces yet.\n[Go to Workspace…](command:drydock.go)",
        "when": "drydock.signedIn"
      },
      {
        "view": "drydock.repositories",
        "contents": "No repositories without a workspace.\n[Refresh Repositories](command:drydock.refreshRepositories)",
        "when": "drydock.signedIn"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "drydock.go",
          "when": "view == drydock.workspaces",
          "group": "navigation"
        },
        {
          "command": "drydock.refreshRepositories",
          "when": "view == drydock.repositories",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "drydock.connect",
          "when": "view == drydock.workspaces && viewItem == workspace.running",
          "group": "inline"
        },
        {
          "command": "drydock.reviewApproval",
          "when": "view == drydock.workspaces && viewItem == workspace.needsApproval",
          "group": "inline"
        },
        {
          "command": "drydock.openInBrowser",
          "when": "view == drydock.workspaces && viewItem =~ /^workspace\\./"
        },
        {
          "command": "drydock.clone",
          "when": "view == drydock.repositories && viewItem == repo.clonable"
        }
      ],
      "editor/title": [
        {
          "command": "drydock.approve",
          "when": "resourceScheme == drydock-approval",
          "group": "navigation@1"
        },
        {
          "command": "drydock.decline",
          "when": "resourceScheme == drydock-approval",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Drydock",
      "properties": {
        "drydock.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "ignoreSync": true,
          "markdownDescription": "The address of your Drydock's web UI: `https://`, a lowercase host and an optional port, with nothing after it, such as `https://drydock.example.com`. The stored token is sent only to the Drydock it was created for: after a change, you are asked whether to sign out of the old one (its token revoked there and forgotten) or keep it for when you switch back, and you sign in to the new one with a token minted there."
        },
        "drydock.connectWhenReady": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "ignoreSync": true,
          "markdownDescription": "Connect to a workspace this window cloned as soon as it is running, without asking."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p src/tsconfig.pure.json",
    "test": "vitest run",
    "bundle": "node scripts/bundle.mjs",
    "check": "npm run typecheck && npm run test && npm run bundle"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/vscode": "1.105.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
